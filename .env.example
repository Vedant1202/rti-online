# Copy to .env.local and fill in. Never commit .env.local.
# Leave DATABASE_URL empty, or set PGLITE=file, to use the local embedded database in .data/pglite.
# PGLITE=file
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=
SESSION_SECRET=change-me-to-32-plus-random-characters
OTP_PEPPER=change-me
GMAIL_USER=
GMAIL_APP_PASSWORD=
SEED_EMAIL_BASE=
MOCK_PAYMENT_SECRET=change-me
CRON_SECRET=change-me
# Google Gemini (AI rewrite and department recommendation). Leave empty to switch AI off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# true = also show the OTP on screen (local dev / live-demo fallback)
DEMO_SHOW_OTP=true
